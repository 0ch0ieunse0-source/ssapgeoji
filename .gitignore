# 설치 파일과 빌드 결과 (다시 만들 수 있어서 올리지 않아요)
node_modules/
dist/
coverage/
*.tsbuildinfo
.vite/

# 비밀 정보: API 키, 환경 변수 파일은 절대 올리지 않아요
.env
.env.*
*.local
*.pem
*.key

# 개인 정보: 거지노트 백업 파일에는 내 가계부 기록이 들어 있어요
*백업*.json
aggim*backup*.json
ssapgeoji*backup*.json

# 로그와 운영체제·편집기 파일
